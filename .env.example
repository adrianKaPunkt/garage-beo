# Kontaktformular (Versand über https://resend.com)
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.

# API-Schlüssel aus dem Resend-Konto
RESEND_API_KEY=

# Absender, die Domain muss bei Resend verifiziert sein
CONTACT_FROM_EMAIL=Garage Beograd <kontakt@garagebeograd.rs>

# Empfänger (optional, Standard ist die E-Mail aus app/site-config.ts)
CONTACT_TO_EMAIL=

# Google-Bewertung (Places API "New", https://console.cloud.google.com)
# Ohne Eintrag zeigt das Badge die festen Werte aus app/site-config.ts
GOOGLE_PLACES_API_KEY=

# Place-ID des Profils (beginnt mit "ChIJ"), zu finden mit dem Place ID Finder:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=ChIJheqXHd93WkcR4KmCHs0M4OA
